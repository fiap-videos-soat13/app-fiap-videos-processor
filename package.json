{
  "name": "app-fiap-videos-processor",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json && cp -r src/adapter/infra/database/migrations dist/adapter/infra/database/",
    "start": "node dist/adapter/infra/http/Main.js",
    "prestart:dev": "docker compose up postgres -d",
    "start:dev": "NODE_ENV=development ts-node -r tsconfig-paths/register src/adapter/infra/http/Main.ts",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "lint:ci": "eslint \"src/**/*.ts\" --max-warnings 0",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "db:migrate": "ts-node -r tsconfig-paths/register scripts/migrate.ts",
    "test:unit": "jest --config jest.config.json"
  },
  "dependencies": {
    "amqplib": "^0.10.8",
    "archiver": "^7.0.1",
    "dotenv": "^17.2.2",
    "drizzle-orm": "^0.44.5",
    "express": "^5.1.0",
    "node-cron": "^4.2.1",
    "pg": "^8.16.3",
    "prom-client": "^15.1.3",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^11.1.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/amqplib": "^0.10.8",
    "@types/archiver": "^6.0.3",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.7",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.15.5",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.9.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "engines": {
    "node": ">=22.0"
  }
}
