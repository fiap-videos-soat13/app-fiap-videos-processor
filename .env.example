PORT=3001
# Service-owned Postgres (docker compose up postgres -d) — port 5434
DATABASE_URL=postgresql://fiap:fiap@localhost:5434/fiap_videos_processor
# Shared infra Postgres (app-fiap-videos-infra/docker) — port 5433
# DATABASE_URL=postgresql://fiap:fiap@localhost:5433/fiap_videos_processor
RABBITMQ_URL=amqp://fiap:fiap@localhost:5673/
VIDEO_EVENTS_EXCHANGE=fiap-videos.events
VIDEO_EVENTS_DLX=fiap-videos.events.dlx
RABBITMQ_CONNECTION_NAME=processor
STORAGE_BACKEND=local
STORAGE_PATH=./storage
# STORAGE_BACKEND=s3
# S3_BUCKET=fiap-videos-staging-videos
# AWS_REGION=sa-east-1
# S3_ENDPOINT=http://localhost:9000
FFMPEG_PATH=ffmpeg
OUTBOX_MAX_ATTEMPTS=10
