PORT=3001
DATABASE_URL=postgresql://fiap:fiap@localhost:5432/fiap_videos_processor
RABBITMQ_URL=amqp://fiap:fiap@localhost:5673/
VIDEO_EVENTS_EXCHANGE=fiap-videos.events
VIDEO_EVENTS_DLX=fiap-videos.events.dlx
RABBITMQ_CONNECTION_NAME=processor
# Object storage — local: MinIO (start via app-fiap-videos-infra/docker compose)
STORAGE_BACKEND=minio
S3_BUCKET=fiap-videos
S3_ENDPOINT=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1

# Production (Kubernetes): STORAGE_BACKEND=s3, S3_BUCKET, AWS_REGION=sa-east-1 (IRSA credentials)
FFMPEG_PATH=ffmpeg
OUTBOX_MAX_ATTEMPTS=10

LOG_FORMAT=pretty
